# Copy to .env beside docker-compose.yml. Everything here is optional —
# `docker compose up -d` works with no .env at all.

# --- Where it listens -------------------------------------------------------
FINSTONE_PORT=8000

# Which interface. Empty means every one, which is what a home LAN wants.
# Set to `127.0.0.1:` (keep the colon) when nginx or Caddy is in front, so the
# proxy is the only route in. With no authentication anywhere, a second open
# port is the whole ledger.
FINSTONE_BIND=

# --- Where your statements are ----------------------------------------------
# Mounted read-only. Drop PDFs in here, then:
#   docker compose run --rm -e FINSTONE_ALLOW_PROD=1 app finstone run --profile prod
FINSTONE_UPLOADS=./uploads

# --- Version ----------------------------------------------------------------
# `latest` tracks main. Pin a release tag once you have data you care about, so
# an upgrade is something you chose rather than something that happened.
FINSTONE_TAG=latest

# --- Postgres ---------------------------------------------------------------
# Only needed if you uncommented the db service. There is no default and there
# must not be one: a password baked into a file people copy is not a password.
#
#   POSTGRES_PASSWORD=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40)
#
# Alphanumeric only — the connection string is built by interpolation, so a
# `/`, `@` or `:` would silently produce a URL pointing somewhere else.
POSTGRES_PASSWORD=

# --- Timezone ---------------------------------------------------------------
# Affects log timestamps and "today" in the dashboard's date ranges. The ledger
# itself stores everything in UTC and is unaffected.
TZ=UTC
