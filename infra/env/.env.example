# Copy to infra/env/.env and edit. Never commit the result.

# --- Database -----------------------------------------------------------
# Postgres is the target. The URL is the only thing that has to change to
# move to another engine — see docs/development-rules.md Rule 1.
POSTGRES_USER=finstone
POSTGRES_PASSWORD=
POSTGRES_DB=finstone
POSTGRES_PORT=5432

# Used when running the CLI on the host rather than in the container.
# Leave unset to fall back to a local SQLite file under data/.
# DATABASE_URL=postgresql+psycopg://finstone:CHANGEME@localhost:5432/finstone

# --- Paths --------------------------------------------------------------
# Defaults are ./uploads and ./data relative to the repository root.
# FINSTONE_UPLOADS_DIR=
# FINSTONE_DATA_DIR=

# --- Safety -------------------------------------------------------------
# uploads/prod holds real financial statements. `stage --profile prod`
# refuses to run unless this is exactly "1". Leave it unset for development.
# Agents must never read uploads/prod at all — see docs/development-rules.md.
# FINSTONE_ALLOW_PROD=1

# --- Parsing ------------------------------------------------------------
# Any statement line above this many minor units is treated as a misparse.
# Default is 10,000,000.00.
# FINSTONE_AMOUNT_CEILING_MINOR=1000000000

# Some e-statements are user-password protected. The dummy documents are only
# owner-restricted and open with an empty password, so these are usually
# unnecessary. Per-institution first, then a shared fallback.
# FINSTONE_PDF_PASSWORD_TRUST_BANK=
# FINSTONE_PDF_PASSWORD_DBS=
# FINSTONE_PDF_PASSWORD=

# --- Tests --------------------------------------------------------------
# Set to also run the pipeline test suite against Postgres. Without it the
# suite runs on SQLite alone, which still exercises both code paths but does
# not prove the Postgres one.
# TEST_DATABASE_URL=postgresql+psycopg://finstone:CHANGEME@localhost:5432/finstone_test
