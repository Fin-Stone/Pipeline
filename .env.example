# Copy to .env and edit. Compose reads .env from this directory automatically.
#
# Nothing here is required for the default stack: `docker compose up` runs on
# SQLite with no configuration at all, which is Rule 3's whole point. Every
# variable below turns something on.

# --- Postgres ---------------------------------------------------------------
# Only read when the postgres overlay is in play:
#
#     docker compose -f docker-compose.yml -f infra/compose/postgres.yml up -d
#
# There is no default and there must not be one. A password baked into a
# repository is not a password.
POSTGRES_PASSWORD=
POSTGRES_USER=finstone
POSTGRES_DB=finstone

# --- Ports ------------------------------------------------------------------
FINSTONE_UI_PORT=8080
FINSTONE_API_PORT=8000

# --- CORS -------------------------------------------------------------------
# Permissive by default, which is honest rather than lax: there is no
# authentication yet, so CORS restricts browsers and not the curl beside them.
# Narrow it once there is something to protect.
FINSTONE_CORS_ORIGINS=*

# --- Deliberately absent ----------------------------------------------------
# FINSTONE_ALLOW_PROD is not set here and should not be. Processing real
# statements is an explicit act each time — see docs/development-rules.md
# Rule 2 — so it is passed on the command that does it:
#
#     docker compose exec -e FINSTONE_ALLOW_PROD=1 cli finstone run --profile prod
